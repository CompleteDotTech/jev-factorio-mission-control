[Unit]
Description=Jev mission control (jev-factorio-agent 1eb7e1d, read-only)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/jev-mission-control
Environment=PYTHONPATH=/opt/jev-mission-control
ExecStart=/usr/bin/python3 -m jev_factorio.dashboard --log-file /var/lib/jev-mission-control/gameplay.jsonl --supervisor-state /var/lib/jev-mission-control/supervisor.json --port 8765 --icon-dir /opt/jev-mission-control/icons
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/jev-mission-control

[Install]
WantedBy=multi-user.target
